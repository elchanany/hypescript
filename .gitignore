# Python (local/)
.venv/
__pycache__/
*.pyc
.env
.env.local
.env.*.local
*_edited.mp4
*_cuts.json
*_transcript.txt
*.srt

# Node / Next (web/)
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
web/.env.local
web/.env.*.local
# תבניות כן נשמרות ב-git:
!web/.env.example
!local/.env.example

# Local env / secrets (never commit)
.env.*
!.env.example
*.pem
*.key

# OS
.DS_Store
Thumbs.db

# local screenshots / scratch artifacts (not part of the product)
.artifacts/

# Cursor / agent runtime state (keep shared rules/hooks/commands tracked)
.cursor/hooks/state/*
!.cursor/hooks/state/.gitkeep
.cursor/*.log

# Graphify — share graph artifacts; ignore runtime/cache/cost/temp
graphify-out/**
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
!graphify-out/manifest.json
!graphify-out/GRAPH_TREE.html
graphify-out/cost.json
graphify-out/cache/
graphify-out/memory/
graphify-out/reflections/
graphify-out/.graphify*
graphify-out/needs_update
graphify-out/.needs_update

# Installer backups / local-only noise
*.graphify-bak
.graphify/
