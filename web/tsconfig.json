{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2020"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-agent-timeline-improvements/types/**/*.ts",
    ".next-agent-storage-persistence-fix/types/**/*.ts",
    ".next-agent-cloud-upload-fix/types/**/*.ts",
    ".next-agent-verify/types/**/*.ts",
    ".next-agent-timeline-snapping-and-captions/types/**/*.ts",
    ".next-agent-multi-drag-snap/types/**/*.ts",
    ".next-agent-billing/types/**/*.ts",
    ".next-agent-renderroute/types/**/*.ts",
    ".next-agent-cloudsubs/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "vitest.config.ts"
  ]
}
