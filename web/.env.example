# =============================================================================
# hypescript — תבנית מפתחות (web)
# =============================================================================
# איך משתמשים:
#   1) העתק קובץ זה ל:  web/.env.local
#      (במסוף מתוך תיקיית web:  cp .env.example .env.local)
#   2) הדבק כל מפתח אחרי סימן =
#   3) שמור, ואז:  npm run dev
#
# ב-Vercel (אתר חי): אותם שמות משתנים → Settings → Environment Variables → Redeploy
# מדריך Auth מפורט: docs/SETUP_AUTH.md
#
# לא חובה למלא הכול. מה שריק = הספק ההוא פשוט לא פעיל.
# הווידאו נשאר מקומי תמיד — המפתחות האלה רק ל-AI / תמלול / התחברות.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) סוכן AI — LLM (צד שרת בלבד, לא מגיעים לדפדפן)
# מספיק אחד כדי שהסוכן יעבוד. מומלץ להתחיל ב-DeepSeek.
# -----------------------------------------------------------------------------

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# אופציונלי: שינוי מודל (ברירת מחדל deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# חלופה לאותו ספק:
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash


# -----------------------------------------------------------------------------
# 2) תמלול (Whisper)
# בלי זה: חיתוך-לפי-סקריפט / תמלול לא יעבדו.
# -----------------------------------------------------------------------------

# Groq (מומלץ, חינמי להתחלה) — https://console.groq.com/keys
GROQ_API_KEY=

# אם מעדיפים תמלול דרך OpenAI (משתמש ב-OPENAI_API_KEY מלמעלה) — אין משתנה נפרד.


# -----------------------------------------------------------------------------
# 3) התחברות (Auth) — אופציונלי לגמרי
# בלי אלה האפליקציה עובדת כרגיל במצב מקומי.
# מדריך: docs/SETUP_AUTH.md
# מאיפה: Supabase → Project Settings → API Keys
# השתמש במפתחות החדשים (לא הטאב Legacy):
# -----------------------------------------------------------------------------

# Project URL — רק https://xxxxxxxx.supabase.co (בלי /rest/v1 בסוף!)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) או Legacy anon JWT — בטוח לדפדפן
# שם המשתנה ANON_KEY נשאר לתאימות; מדביקים כאן את ה-Publishable
# אסור: Secret key / service_role / sb_secret_
# בלי מרכאות מסביב לערך!
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# אופציונלי — אם מוגדר, מקבל עדיפות על ANON_KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret / service_role — SERVER בלבד. אסור NEXT_PUBLIC_*. נדרש ל-Bootstrap System Owner.
SUPABASE_SERVICE_ROLE_KEY=

# אימייל ה-System Owner הראשון (server-side בלבד). אחרי Bootstrap הזהות היא UUID.
BOOTSTRAP_SUPER_ADMIN_EMAIL=eyceyceyc139@gmail.com

# כש-Auth מוגדר: false = עורך דורש התחברות. true = אפשר Guest editor.
ALLOW_GUEST_EDITOR=true

# בסיס URL ל-metadata / Open Graph (Production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ElevenLabs (תמלול/קריינות) — server-side בלבד
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

